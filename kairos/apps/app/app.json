{
  "expo": {
    "name": "Tender",
    "slug": "tender",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tender",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0A0C",
    "ios": {
      "bundleIdentifier": "com.9labs.tenderapp",
      "buildNumber": "3",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSHealthShareUsageDescription": "Tender can read the dates of past periods from Apple Health, only if she chooses to import them. The dates are used on this phone to follow her cycle.",
        "NSHealthUpdateUsageDescription": "Tender never writes anything to Apple Health."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.ninelabs.tender",
      "adaptiveIcon": {
        "backgroundColor": "#0D0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": true,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Tender",
      "shortName": "Tender",
      "themeColor": "#0D0A0C",
      "backgroundColor": "#0D0A0C",
      "description": "Her rhythm. Your moment. One small idea a day, timed to her cycle."
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFAA6B"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Tender adds a private “Seasons” calendar with all-day, free events. It never reads your other events.",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tender reads the photo or screenshot you choose on this phone to find period days. It is never uploaded.",
          "cameraPermission": "Tender uses the camera to photograph her cycle calendar so it can find the period days. The photo is read on this phone and never uploaded.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "SeasonWidget",
              "displayName": "Season",
              "description": "Her season at a glance, discreetly.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
